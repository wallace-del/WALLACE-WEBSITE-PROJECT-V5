# Never commit a real production .env file.
POSTGRES_PASSWORD=generate-a-long-random-database-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-unique-long-admin-password
JWT_SECRET=generate-a-random-secret-at-least-64-characters
NODE_ENV=production
CORS_ORIGINS=https://your-domain.example

EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# Keep the same value during the V4 -> V5 local upgrade so the existing volumes are reused.
COMPOSE_PROJECT_NAME=wallacewebsiteprojectv2
